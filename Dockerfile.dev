# syntax=docker/dockerfile:1.7

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DJANGO_SETTINGS_MODULE=my_site.settings.dev \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /code

RUN addgroup --system app && adduser --system --ingroup app app \
    && apt-get update \
    && apt-get install -y --no-install-recommends gosu \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /tmp/requirements.txt

# Install primarily from local Linux wheels, fall back to PyPI when missing.
COPY --from=linux_wheels / /wheels/linux/

RUN python -m pip install --upgrade pip && \
    pip install --find-links=/wheels/linux -r /tmp/requirements.txt

COPY . .

RUN mkdir -p /code/staticfiles /code/media /code/logs /code/backups && \
    chown -R app:app /code && \
    chmod -R 755 /code/staticfiles /code/media /code/logs /code/backups

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 8000

ENTRYPOINT ["sh", "/usr/local/bin/entrypoint.sh"]
