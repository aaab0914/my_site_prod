# =============================================================================
# SECURITY
# =============================================================================

# Comma-separated list of allowed host/domain names.
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# HTTP-only flag for CSRF cookie (prevents JavaScript access).
CSRF_COOKIE_HTTPONLY=True

# Secure flag for CSRF cookie (requires HTTPS in production).
CSRF_COOKIE_SECURE=True

# SameSite policy for CSRF cookie.
CSRF_COOKIE_SAMESITE=Lax

# Comma-separated list of trusted origins for unsafe requests (POST, PUT, DELETE).
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Secret key for cryptographic signing. Keep this value secret!
SECRET_KEY=change-me

# Cross-Origin-Opener-Policy header value.
SECURE_CROSS_ORIGIN_OPENER_POLICY=same-origin

# HTTP Strict Transport Security: include subdomains.
SECURE_HSTS_INCLUDE_SUBDOMAINS=True

# HTTP Strict Transport Security: preload list.
SECURE_HSTS_PRELOAD=True

# HTTP Strict Transport Security duration in seconds (1 year).
SECURE_HSTS_SECONDS=31536000

# Referrer-Policy header value.
SECURE_REFERRER_POLICY=same-origin

# Redirect all HTTP requests to HTTPS.
SECURE_SSL_REDIRECT=True

# HTTP-only flag for session cookie (prevents JavaScript access).
SESSION_COOKIE_HTTPONLY=True

# Secure flag for session cookie (requires HTTPS in production).
SESSION_COOKIE_SECURE=True

# SameSite policy for session cookie.
SESSION_COOKIE_SAMESITE=Lax

# =============================================================================
# DATABASE — PostgreSQL
# =============================================================================

# Full PostgreSQL connection string (scheme://user:password@host:port/name).
DATABASE_URL=postgresql://my_site_user:change-me@db:5432/my_site_db

# PostgreSQL host (Docker service name).
DB_HOST=db

# PostgreSQL database name.
DB_NAME=my_site_db

# PostgreSQL user password.
DB_PASSWORD=change-me

# PostgreSQL port (internal container port).
DB_PORT=5432

# PostgreSQL user name.
DB_USER=my_site_user

# =============================================================================
# DJANGO CORE
# =============================================================================

# Debug mode: enables verbose error pages (must be False in production).
DEBUG=False

# Shared maximum upload size for Django request/file handling.
UPLOAD_MAX_MEMORY_SIZE=125829120

# Python dotted path to the Django settings module.
DJANGO_SETTINGS_MODULE=my_site.settings.prod

# =============================================================================
# ELASTICSEARCH
# =============================================================================

# Elasticsearch HTTP endpoint.
ELASTICSEARCH_URL=http://elasticsearch:9200

# =============================================================================
# REDIS & CELERY
# =============================================================================

# Celery task broker URL (Redis transport).
CELERY_BROKER_URL=redis://redis:6379/0

# Celery result backend URL (Redis).
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Redis cache / session backend URL.
REDIS_URL=redis://redis:6379/0

# =============================================================================
# DOCKER
# =============================================================================

# Flag indicating the application runs inside a Docker container.
RUNNING_IN_DOCKER=true

# =============================================================================
# SENTRY — Error Tracking
# =============================================================================

# Sentry project DSN. Leave empty to disable error reporting.
SENTRY_DSN=

# Sentry profiling sample rate (0.0 = disabled, 1.0 = all transactions).
SENTRY_PROFILES_SAMPLE_RATE=0.0

# Sentry tracing sample rate (0.0 = disabled, 1.0 = all transactions).
SENTRY_TRACES_SAMPLE_RATE=0.0
