# =============================================
# Django Settings
# =============================================
DJANGO_SETTINGS_MODULE=my_site.settings.dev
DEBUG=True
SECRET_KEY=development-only-key
ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================
# Database
# =============================================
DB_NAME=my_site_db
DB_USER=my_site_user
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgresql://my_site_user:change-me@db:5432/my_site_db

# =============================================
# Redis & Celery
# =============================================
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
# Retry broker connection on worker startup (useful when Redis is not ready yet)
CELERY_BROKER_CONNECTION_RETRY_ON_STARTUP=True

# =============================================
# Elasticsearch
# =============================================
ELASTICSEARCH_URL=http://elasticsearch:9200

# =============================================
# Development Ports
# =============================================
DEV_DB_PORT=5433
DEV_WEB_PORT=8001

# =============================================
# Docker & Upload Limits
# =============================================
RUNNING_IN_DOCKER=true
# Max size of the entire request body (120 MB)
DATA_UPLOAD_MAX_MEMORY_SIZE=125829120
# Max size of a single uploaded file before spooling to disk (2.5 MB)
FILE_UPLOAD_MAX_MEMORY_SIZE=2621440